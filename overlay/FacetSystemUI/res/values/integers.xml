<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Facet: how notification icons appear in the status bar.
         0 = all icons (stock Android behaviour)
         1 = alerting only, hiding silent and ambient notifications
         2 = a single neutral dot when anything is pending
         3 = hidden entirely

         This resource only exists on a build carrying
         patches/systemui/0003. On a stock build the overlay entry is
         simply unused, so including it here is harmless either way. -->
    <integer name="facet_status_bar_notification_icon_mode">2</integer>
</resources>
