+package com.android.systemui.facet
+
+import android.graphics.RuntimeShader
+
+/**
+ * Bends the content behind a glass surface near its vertical edges.
+ *
+ * A real pane of glass is thickest where it curves away, so light passing near
+ * the rim is displaced further than light through the middle. This shader
+ * reproduces that: sampling is pushed inward at both left and right rims, with
+ * the displacement falling to nothing across the centre.
+ *
+ * It is meant to be chained *after* a blur, so it refracts already-diffused
+ * content rather than sharp pixels.
+ */
+class FacetRefractionShader : RuntimeShader(SHADER) {
+
+    /** Peak displacement at the rim, in pixels. */
+    var strength: Float = 6f
+        set(value) {
+            field = value
+            setFloatUniform("in_strength", value)
+        }
+
+    /** Width of the bending band at each edge, in pixels. */
+    var rim: Float = 48f
+        set(value) {
+            field = value
+            setFloatUniform("in_rim", value)
+        }
+
+    /** Surface size in pixels; sampling is clamped to it. */
+    fun setSize(width: Float, height: Float) {
+        setFloatUniform("in_size", width, height)
+    }
+
+    init {
+        strength = strength
+        rim = rim
+    }
+
+    companion object {
+        /** Name of the input shader uniform, for createRuntimeShaderEffect. */
+        const val INPUT_SHADER_NAME = "in_src"
+
+        private const val UNIFORMS = """
+            uniform shader in_src;
+            uniform vec2 in_size;
+            uniform float in_strength;
+            uniform float in_rim;
+        """
+
+        private const val MAIN = """
+            vec4 main(vec2 p) {
+                float rim = max(in_rim, 1.0);
+
+                // Distance into the surface from each vertical edge, in rim widths.
+                float dl = p.x / rim;
+                float dr = (in_size.x - p.x) / rim;
+
+                // Positive near the left rim, negative near the right, ~0 across
+                // the middle, so both edges bend inward and the centre is undisturbed.
+                float bend = exp(-dl * dl) - exp(-dr * dr);
+
+                vec2 uv = p + vec2(bend * in_strength, 0.0);
+
+                // Never sample outside the surface, or the rim smears.
+                uv.x = clamp(uv.x, 0.0, max(in_size.x - 1.0, 0.0));
+                uv.y = clamp(uv.y, 0.0, max(in_size.y - 1.0, 0.0));
+
+                return in_src.eval(uv);
+            }
+        """
+
+        private const val SHADER = UNIFORMS + MAIN
+    }
+}
