+    private RenderEffect chainFacetRefraction(RenderEffect blur) {
+        final int width = getWidth();
+        final int height = getHeight();
+        if (width <= 0 || height <= 0) {
+            return blur;
+        }
+        if (mFacetRefractionShader == null) {
+            mFacetRefractionShader = new FacetRefractionShader();
+        }
+        final float density = getResources().getDisplayMetrics().density;
+        mFacetRefractionShader.setSize(width, height);
+        mFacetRefractionShader.setStrength(FACET_REFRACTION_STRENGTH_DP * density);
+        mFacetRefractionShader.setRim(FACET_REFRACTION_RIM_DP * density);
