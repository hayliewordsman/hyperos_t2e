 <!-- These resources are around just to allow their values to be customized
      for different hardware and product builds. -->
 <resources>
+
+    <!-- Facet: how notification icons appear in the status bar.
+         0 = all icons (stock Android behaviour)
+         1 = alerting only, hiding silent and ambient notifications
+         2 = a single neutral dot when anything is pending
+         3 = hidden entirely
+         Overridable by an RRO, so the mode can be changed without rebuilding. -->
+    <integer name="facet_status_bar_notification_icon_mode">2</integer>
+
     <!-- Component to be used as the recents implementation.  Must implement the
